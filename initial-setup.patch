new file mode 100644
index 0000000..d834c45
--- /dev/null
+++ b/src/game/createArenaScene.ts
@@ -0,0 +1,45 @@
+import { Container, Sprite, TilingSprite } from 'pixi.js';
+import type { ArenaAssets } from './assets';
+import { arenaConfig } from './config';
+
+export function createArenaScene(assets: ArenaAssets): Container {
+  const world = new Container();
+  world.eventMode = 'none';
+
+  const water = new TilingSprite({
+    texture: assets.water,
+    width: arenaConfig.width,
+    height: arenaConfig.height,
+  });
+  world.addChild(water);
+
+  assets.islandTiles.forEach((texture, index) => {
+    const tile = new Sprite(texture);
+    tile.position.set(
+      arenaConfig.island.x + (index % arenaConfig.island.columns) * arenaConfig.tileSize,
+      arenaConfig.island.y + Math.floor(index / arenaConfig.island.columns) * arenaConfig.tileSize,
+    );
+    world.addChild(tile);
+  });
+
+  const palm = new Sprite(assets.palm);
+  palm.anchor.set(0.5);
+  palm.position.set(arenaConfig.island.x + 96, arenaConfig.island.y + 96);
+  world.addChild(palm);
+
+  const shadow = new Sprite(assets.ship);
+  shadow.anchor.set(0.5);
+  shadow.position.set(arenaConfig.player.x + 7, arenaConfig.player.y + 9);
+  shadow.rotation = arenaConfig.player.rotation;
+  shadow.tint = 0x123844;
+  shadow.alpha = 0.3;
+  world.addChild(shadow);
+
+  const ship = new Sprite(assets.ship);
+  ship.anchor.set(0.5);
+  ship.position.set(arenaConfig.player.x, arenaConfig.player.y);
+  ship.rotation = arenaConfig.player.rotation;
+  world.addChild(ship);
+
+  return world;
+}
diff --git a/src/game/mountArena.ts b/src/game/mountArena.ts
new file mode 100644
index 0000000..848103e
--- /dev/null
+++ b/src/game/mountArena.ts
@@ -0,0 +1,93 @@
+import { Application } from 'pixi.js';
+import { loadArenaAssets } from './assets';
+import { arenaConfig } from './config';
+import { createArenaScene } from './createArenaScene';
+
+interface ArenaCallbacks {
+  onReady: () => void;
+  onError: () => void;
+}
+
+export function mountArena(host: HTMLDivElement, callbacks: ArenaCallbacks): () => void {
+  const app = new Application();
+  let disposed = false;
+  let initialized = false;
+  let resizeObserver: ResizeObserver | undefined;
+  let removeResizeListener: (() => void) | undefined;
+
+  function releaseResources() {
+    resizeObserver?.disconnect();
+    removeResizeListener?.();
+
+    if (initialized) {
+      initialized = false;
+      // Textures belong to the shared Assets cache; sprites belong to this scene.
+      app.destroy({ removeView: true }, { children: true, texture: false, textureSource: false });
+    }
+  }
+
+  async function initialize() {
+    await app.init({
+      width: arenaConfig.width,
+      height: arenaConfig.height,
+      resolution: Math.min(window.devicePixelRatio || 1, 2),
+      autoDensity: true,
+      antialias: true,
+      background: 0x208da7,
+      preference: 'webgl',
+      autoStart: false,
+      sharedTicker: false,
+    });
+    initialized = true;
+
+    // Strict Mode or a quick exit can dispose the effect while init is pending.
+    if (disposed) {
+      releaseResources();
+      return;
+    }
+
+    const assets = await loadArenaAssets();
+
+    if (disposed) return;
+
+    const world = createArenaScene(assets);
+    app.stage.addChild(world);
+    app.canvas.setAttribute('role', 'img');
+    app.canvas.setAttribute('aria-label', 'Ocean arena with a pirate ship and a tropical island');
+    host.appendChild(app.canvas);
+
+    function resize() {
+      if (disposed || !initialized) return;
+
+      const { width, height } = host.getBoundingClientRect();
+      if (width <= 0 || height <= 0) return;
+
+      app.renderer.resize(width, height, Math.min(window.devicePixelRatio || 1, 2));
+      const scale = Math.min(width / arenaConfig.width, height / arenaConfig.height);
+      world.scale.set(scale);
+      world.position.set(
+        (width - arenaConfig.width * scale) / 2,
+        (height - arenaConfig.height * scale) / 2,
+      );
+      // A static scene needs no running ticker. Render again only after resizing.
+      app.render();
+    }
+
+    resizeObserver = new ResizeObserver(resize);
+    resizeObserver.observe(host);
+    window.addEventListener('resize', resize);
+    removeResizeListener = () => window.removeEventListener('resize', resize);
+    resize();
+    callbacks.onReady();
+  }
+
+  void initialize().catch(() => {
+    releaseResources();
+    if (!disposed) callbacks.onError();
+  });
+
+  return () => {
+    disposed = true;
+    releaseResources();
+  };
+}
